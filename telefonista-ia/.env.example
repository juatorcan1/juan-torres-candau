# Copia este fichero como .env y rellénalo (o pon estas variables en el alojamiento).

# Clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Auth Token de la cuenta de Twilio (console.twilio.com): comprueba que las llamadas vienen de Twilio
TWILIO_AUTH_TOKEN=
# Dirección pública de este servidor, con https (la que se pone en Twilio)
URL_PUBLICA=https://telefonista.midominio.com

# Opcional: clave del panel en directo (https://<URL_PUBLICA>/panel), 10 caracteres o más
PANEL_CLAVE=

# Opcional: dónde guardar lo apuntado. Sin esto, va a datos/registros.jsonl
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: modelo y cuánto piensa antes de hablar (low = más rápido; medium = más reflexivo)
# MODELO=claude-opus-5-5
# ESFUERZO=low
# PORT=8080
# EMPRESAS_DIR=empresas
